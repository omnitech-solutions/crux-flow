  "references": {
    "application-boundaries": {
      "name": "Application boundaries",
      "family": "architecture",
      "terms": ["application boundaries", "route", "service", "repository", "domain logic", "SQL", "form", "component", "CSS"],
      "purpose": "Who owns transport, application services, domain rules, repositories and UI composition in this repository, as one narrowly scoped page the project writes: a decision table (what you are about to write, and where it belongs), the imports each layer may use, and the commands that check it, all derived from the project's own packages and folders. It prescribes no universal directory structure."
    }
  },
