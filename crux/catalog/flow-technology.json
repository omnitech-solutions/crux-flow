    "language": "The language and runtime a package is written for.",
    "ui": "Browser user interface and the web framework that renders it.",
    "api": "HTTP routing and validation at a boundary.",
    "persistence": "Schemas, migrations, queries and the database server.",
    "ai-runtime": "Model provider SDKs, agent runtimes and the protocols they speak.",
    "testing": "Unit, integration and browser test runners.",
    "native": "Native desktop application code.",
    "operations": "Logging and local service orchestration.",
    "architecture": "How responsibilities are divided inside an application. The page is the project's own; nothing is detected from a manifest."
