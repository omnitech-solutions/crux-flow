{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "crux implementation decision (format_version 1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "format_version",
    "book_id",
    "run_id",
    "slug",
    "revision",
    "slot",
    "display_title",
    "scope",
    "constraint_refs",
    "reasoning",
    "alternatives",
    "approach",
    "assumptions",
    "intended_evidence",
    "source_labels"
  ],
  "properties": {
    "record_type": {
      "const": "implementation-decision"
    },
    "format_version": {
      "const": "1"
    },
    "book_id": {
      "type": "string",
      "pattern": "^(?:(?!(?:PB|ADR|RUN|BRIEF)-)[A-Z][A-Z0-9]{1,9}-)?PB-\\d{4}(?![\\s\\S])"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-\\d{3}(?![\\s\\S])"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "slot": {
      "type": "string",
      "pattern": "^(?:(?:implementation|verify)-[1-9]\\d*|patch)(?![\\s\\S])"
    },
    "display_title": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraint_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:(?!(?:PB|ADR|RUN|BRIEF)-)[A-Z][A-Z0-9]{1,9}-)?ADR-\\d{4}/[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
      }
    },
    "reasoning": {
      "type": "string",
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approach": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "intended_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_labels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "path"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "related_choices": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "no_governing_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "pattern": "^(?=[^\\x00-\\x1f\\x7f]*\\S)[^\\x00-\\x1f\\x7f]{1,500}(?![\\s\\S])"
        }
      },
      "$comment": "Declares that no architectural constraint governs the scope. Valid only beside an empty constraint_refs list; the reason is one line of 1 to 500 characters."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "no_governing_constraint"
        ]
      },
      "then": {
        "properties": {
          "constraint_refs": {
            "items": false
          }
        }
      },
      "else": {
        "properties": {
          "constraint_refs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
