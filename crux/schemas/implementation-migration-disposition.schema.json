{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "format_version",
    "producer",
    "batch_id",
    "source_identity",
    "entry_sha256",
    "dependency",
    "subject",
    "disposition",
    "human_instruction",
    "rationale",
    "signed"
  ],
  "properties": {
    "record_type": {
      "const": "implementation-migration-dependency-disposition"
    },
    "format_version": {
      "const": "1"
    },
    "producer": {
      "enum": [
        "reconcile-signoff/migration-disposition-1",
        "backfill-signoff/migration-disposition-1"
      ]
    },
    "batch_id": {
      "type": "string",
      "pattern": "^implementation-pilot-001(?:-recovery-[0-9a-f]{64})?(?![\\s\\S])"
    },
    "source_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "entry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\\x00-\\x1f\\x7f]+(?:/[^/\\\\\\x00-\\x1f\\x7f]+)*(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "subject": {
      "type": "object"
    },
    "disposition": {
      "const": "preserve-signed-history-and-migrate-entry"
    },
    "human_instruction": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "signed": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
    },
    "replacement_pairings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invariant",
          "handle",
          "row_sha256",
          "content_digest"
        ],
        "properties": {
          "invariant": {
            "type": "string",
            "pattern": "^(INV-\\d{4}|OBS-\\d{4}/[a-z][a-z0-9-]*)(?![\\s\\S])"
          },
          "handle": {
            "type": "string",
            "pattern": "^(?:[A-Z][A-Z0-9]{1,9}-)?ADR-[0-9]{4}/[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
          },
          "row_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          },
          "content_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "producer": {
            "const": "reconcile-signoff/migration-disposition-1"
          }
        }
      },
      "then": {
        "required": [
          "replacement_pairings"
        ],
        "properties": {
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "invariant",
              "member_kind",
              "handle",
              "row_sha256",
              "content_digest"
            ],
            "properties": {
              "kind": {
                "const": "doctrine-pairing"
              },
              "invariant": {
                "type": "string",
                "pattern": "^(INV-\\d{4}|OBS-\\d{4}/[a-z][a-z0-9-]*)(?![\\s\\S])"
              },
              "member_kind": {
                "enum": [
                  "invariant",
                  "observation"
                ]
              },
              "handle": {
                "type": "string",
                "pattern": "^(?:[A-Z][A-Z0-9]{1,9}-)?ADR-[0-9]{4}/[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
              },
              "row_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              },
              "content_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "handle",
              "receipt_sha256",
              "signing_batch_sha256"
            ],
            "properties": {
              "kind": {
                "const": "backfill-receipt"
              },
              "handle": {
                "type": "string",
                "pattern": "^(?:[A-Z][A-Z0-9]{1,9}-)?ADR-[0-9]{4}/[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
              },
              "receipt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              },
              "signing_batch_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              }
            }
          },
          "replacement_pairings": {
            "const": null
          }
        }
      }
    }
  ]
}
