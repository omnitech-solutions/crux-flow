{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "crux promptbook (format_version 1 or 2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "id",
    "title",
    "status",
    "created_at",
    "total_prompts",
    "current_run",
    "current_prompt",
    "forked_from",
    "tags",
    "goal",
    "strategy",
    "prompts"
  ],
  "properties": {
    "format_version": {
      "type": "string",
      "enum": [
        "1",
        "2"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^(?:(?!(?:PB|ADR|RUN|BRIEF)-)[A-Z][A-Z0-9]{1,9}-)?PB-\\d{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "total_prompts": {
      "type": "integer",
      "minimum": 1
    },
    "current_run": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^RUN-\\d{3}$"
    },
    "current_prompt": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "forked_from": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:(?!(?:PB|ADR|RUN|BRIEF)-)[A-Z][A-Z0-9]{1,9}-)?PB-\\d{4}$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cycle_kind": {
      "type": "string",
      "enum": [
        "adr",
        "implementation",
        "verify",
        "patch"
      ]
    },
    "blast_radius": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cycle_grandfathered": {
      "type": "boolean"
    },
    "grandfather_reason": {
      "type": "string"
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adrs": {
          "type": "integer",
          "minimum": 0
        },
        "implementations": {
          "type": "integer",
          "minimum": 0
        },
        "verify": {
          "type": "integer",
          "minimum": 0
        },
        "dev_loops": {
          "type": "integer",
          "minimum": 1
        },
        "review_cycles": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "type": "string",
      "minLength": 1
    },
    "run_autonomy": {
      "type": "string"
    },
    "archive_note": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "archived_at",
        "final_run",
        "note"
      ],
      "properties": {
        "archived_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "final_run": {
          "type": "string",
          "pattern": "^RUN-\\d{3}$"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "title",
          "purpose",
          "prompt",
          "expected_output"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "expected_output": {
            "type": "string"
          },
          "side_effects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "module_tag": {
            "type": "string",
            "pattern": "^(adr|implementation|dev|review|verify)-\\d+$"
          },
          "phase": {
            "type": "string",
            "enum": [
              "verify",
              "plan",
              "implement",
              "review",
              "summary"
            ]
          }
        }
      }
    },
    "implementation_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "slug",
          "scope",
          "constraint_refs"
        ],
        "properties": {
          "slot": {
            "type": "string",
            "pattern": "^(?:(?:implementation|verify)-[1-9]\\d*|patch)(?![\\s\\S])"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\\x00-\\x1f\\x7f]+(?:/[^/\\\\\\x00-\\x1f\\x7f]+)*(?![\\s\\S])"
            }
          },
          "constraint_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:(?!(?:PB|ADR|RUN|BRIEF)-)[A-Z][A-Z0-9]{1,9}-)?ADR-\\d{4}/[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
            }
          },
          "migration_batch": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "path"
            ],
            "properties": {
              "role": {
                "const": "migration-batch"
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\\x00-\\x1f\\x7f]+(?:/[^/\\\\\\x00-\\x1f\\x7f]+)*(?![\\s\\S])"
              }
            }
          },
          "no_governing_constraint": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "pattern": "^(?=[^\\x00-\\x1f\\x7f]*\\S)[^\\x00-\\x1f\\x7f]{1,500}(?![\\s\\S])"
              }
            },
            "$comment": "Declares that no architectural constraint governs the scope. Valid only beside an empty constraint_refs list; the reason is one line of 1 to 500 characters."
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "no_governing_constraint"
              ]
            },
            "then": {
              "properties": {
                "constraint_refs": {
                  "items": false
                }
              }
            },
            "else": {
              "properties": {
                "constraint_refs": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "migration_batch"
              ]
            },
            "then": {
              "properties": {
                "no_governing_constraint": false
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "format_version"
        ],
        "properties": {
          "format_version": {
            "const": "1"
          }
        }
      },
      "then": {
        "properties": {
          "cycle_kind": {
            "type": "string",
            "enum": [
              "adr",
              "verify",
              "patch"
            ]
          },
          "modules": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "adrs": {
                "type": "integer",
                "minimum": 1
              },
              "verify": {
                "type": "integer",
                "minimum": 1
              },
              "dev_loops": {
                "type": "integer",
                "minimum": 1
              },
              "review_cycles": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "prompts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "n",
                "title",
                "purpose",
                "prompt",
                "expected_output"
              ],
              "properties": {
                "n": {
                  "type": "integer",
                  "minimum": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "purpose": {
                  "type": "string"
                },
                "prompt": {
                  "type": "string"
                },
                "expected_output": {
                  "type": "string"
                },
                "side_effects": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "module_tag": {
                  "type": "string",
                  "pattern": "^(adr|dev|review|verify)-\\d+$"
                },
                "phase": {
                  "type": "string",
                  "enum": [
                    "verify",
                    "plan",
                    "implement",
                    "review",
                    "summary"
                  ]
                }
              }
            }
          },
          "implementation_slots": {
            "type": "null",
            "const": false,
            "$comment": "Presence is forbidden in this format; both constraints are supported and cannot hold together."
          }
        },
        "allOf": [
          {
            "$comment": "A cycle-tagged book needs a modules block only for the module-structured kinds. cycle_kind: patch has five phases and no modules; `properties` applies only when the key is present, so a cycle-tagged book with no cycle_kind still requires modules (unchanged).",
            "if": {
              "properties": {
                "tags": {
                  "contains": {
                    "const": "cycle"
                  }
                },
                "cycle_kind": {
                  "enum": [
                    "adr",
                    "verify"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "modules"
              ]
            }
          },
          {
            "if": {
              "required": [
                "cycle_kind"
              ],
              "properties": {
                "cycle_kind": {
                  "const": "patch"
                }
              }
            },
            "then": {
              "required": [
                "blast_radius"
              ]
            }
          },
          {
            "if": {
              "required": [
                "cycle_kind"
              ],
              "properties": {
                "cycle_kind": {
                  "const": "adr"
                }
              }
            },
            "then": {
              "properties": {
                "modules": {
                  "required": [
                    "adrs",
                    "dev_loops",
                    "review_cycles"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "cycle_kind"
              ],
              "properties": {
                "cycle_kind": {
                  "const": "verify"
                }
              }
            },
            "then": {
              "properties": {
                "modules": {
                  "required": [
                    "verify",
                    "dev_loops",
                    "review_cycles"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "cycle_grandfathered"
              ],
              "properties": {
                "cycle_grandfathered": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "grandfather_reason"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "format_version"
        ],
        "properties": {
          "format_version": {
            "const": "2"
          }
        }
      },
      "then": {
        "required": [
          "cycle_kind",
          "implementation_slots"
        ],
        "properties": {
          "cycle_grandfathered": {
            "type": "null",
            "const": false,
            "$comment": "Presence is forbidden in this format; both constraints are supported and cannot hold together."
          },
          "grandfather_reason": {
            "type": "null",
            "const": false,
            "$comment": "Presence is forbidden in this format; both constraints are supported and cannot hold together."
          },
          "prompts": {
            "items": {
              "properties": {
                "module_tag": {
                  "pattern": "^(adr|implementation|dev|review|verify)-[1-9]\\d*(?![\\s\\S])"
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "cycle_kind"
              ],
              "properties": {
                "cycle_kind": {
                  "enum": [
                    "adr",
                    "implementation",
                    "verify"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "modules"
              ],
              "properties": {
                "modules": {
                  "required": [
                    "adrs",
                    "implementations",
                    "verify",
                    "dev_loops",
                    "review_cycles"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "cycle_kind"
              ],
              "properties": {
                "cycle_kind": {
                  "const": "patch"
                }
              }
            },
            "then": {
              "required": [
                "blast_radius"
              ],
              "properties": {
                "modules": {
                  "type": "null",
                  "const": false,
                  "$comment": "Format-two patch books have five phases, not module composition. Presence is forbidden, including an empty object."
                }
              }
            }
          }
        ]
      }
    }
  ]
}
