{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "crux promptbook (format_version 1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "id",
    "title",
    "status",
    "created_at",
    "total_prompts",
    "current_run",
    "current_prompt",
    "forked_from",
    "tags",
    "goal",
    "strategy",
    "prompts"
  ],
  "properties": {
    "format_version": { "const": "1" },
    "id": { "type": "string", "pattern": "^(?:(?!(?:PB|ADR|RUN|BRIEF)-)[A-Z][A-Z0-9]{1,9}-)?PB-\\d{4}$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["active", "archived"] },
    "created_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "total_prompts": { "type": "integer", "minimum": 1 },
    "current_run": { "type": ["string", "null"], "pattern": "^RUN-\\d{3}$" },
    "current_prompt": { "type": ["integer", "null"], "minimum": 1 },
    "forked_from": { "type": ["string", "null"], "pattern": "^(?:(?!(?:PB|ADR|RUN|BRIEF)-)[A-Z][A-Z0-9]{1,9}-)?PB-\\d{4}$" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "cycle_kind": { "type": "string", "enum": ["adr", "verify", "patch"] },
    "blast_radius": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "cycle_grandfathered": { "type": "boolean" },
    "grandfather_reason": { "type": "string" },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adrs": { "type": "integer", "minimum": 1 },
        "verify": { "type": "integer", "minimum": 1 },
        "dev_loops": { "type": "integer", "minimum": 1 },
        "review_cycles": { "type": "integer", "minimum": 1 }
      }
    },
    "goal": { "type": "string", "minLength": 1 },
    "strategy": { "type": "string", "minLength": 1 },
    "run_autonomy": { "type": "string" },
    "archive_note": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["archived_at", "final_run", "note"],
      "properties": {
        "archived_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "final_run": { "type": "string", "pattern": "^RUN-\\d{3}$" },
        "note": { "type": "string" }
      }
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "title", "purpose", "prompt", "expected_output"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string" },
          "prompt": { "type": "string" },
          "expected_output": { "type": "string" },
          "side_effects": { "type": "array", "items": { "type": "string" } },
          "module_tag": { "type": "string", "pattern": "^(adr|dev|review|verify)-\\d+$" },
          "phase": {
            "type": "string",
            "enum": ["verify", "plan", "implement", "review", "summary"]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "A cycle-tagged book needs a modules block only for the module-structured kinds. cycle_kind: patch has five phases and no modules; `properties` applies only when the key is present, so a cycle-tagged book with no cycle_kind still requires modules (unchanged).",
      "if": {
        "properties": {
          "tags": { "contains": { "const": "cycle" } },
          "cycle_kind": { "enum": ["adr", "verify"] }
        }
      },
      "then": {
        "required": ["modules"]
      }
    },
    {
      "if": {
        "required": ["cycle_kind"],
        "properties": { "cycle_kind": { "const": "patch" } }
      },
      "then": {
        "required": ["blast_radius"]
      }
    },
    {
      "if": {
        "required": ["cycle_kind"],
        "properties": { "cycle_kind": { "const": "adr" } }
      },
      "then": {
        "properties": { "modules": { "required": ["adrs", "dev_loops", "review_cycles"] } }
      }
    },
    {
      "if": {
        "required": ["cycle_kind"],
        "properties": { "cycle_kind": { "const": "verify" } }
      },
      "then": {
        "properties": { "modules": { "required": ["verify", "dev_loops", "review_cycles"] } }
      }
    },
    {
      "if": {
        "required": ["cycle_grandfathered"],
        "properties": { "cycle_grandfathered": { "const": true } }
      },
      "then": {
        "required": ["grandfather_reason"]
      }
    }
  ]
}
