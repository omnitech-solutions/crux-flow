{
  "name": "omnitech-ai-engine-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "build": "pnpm -r --if-present run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome lint --write .",
    "verify:no-frameworks": "node scripts/verify-no-frameworks.mjs",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:no-frameworks",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:live:context": "vitest run --config vitest.live.config.ts packages/ai-engine/live/context-",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:setup": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/db-setup.ts",
    "db:psql": "docker compose exec postgres psql -U engine -d engine",
    "dev": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/dev.ts",
    "ai-engine": "node --experimental-transform-types --disable-warning=ExperimentalWarning packages/ai-engine/src/cli.ts",
    "tts": "pnpm -s ai-engine speech render",
    "speech:install": "pnpm -s ai-engine speech install",
    "speech:up": "pnpm -s ai-engine speech up",
    "speech:down": "pnpm -s ai-engine speech down",
    "speech:status": "pnpm -s ai-engine speech status",
    "db:reset": "docker compose exec -T postgres psql -U engine -d engine -c 'drop schema if exists ai cascade' && pnpm db:setup"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@types/node": "22.20.4",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "3.2.7",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "lefthook": "^2.2.1",
    "pg": "^8.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
