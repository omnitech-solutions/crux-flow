{
  "name": "@omnitech/database",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -b",
    "lint": "biome lint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.package.config.ts",
    "db:migrate": "tsx src/migrate-command.ts",
