    "db:names": "node scripts/write-migration-names.mjs"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
